# Copy to .env and fill in. Read by react-native-config at build time:
# after changing a value, rebuild the app (a Metro reload is not enough).

# API base URL without a trailing slash. Android device on the same Wi-Fi: http://<PC LAN IP>:3000
# (or http://localhost:3000 with `adb reverse tcp:3000 tcp:3000`). Release builds must use https://.
API_URL=http://localhost:3000
